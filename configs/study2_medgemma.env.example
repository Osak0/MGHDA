# Copy to configs/study2_medgemma.env and edit locally. The copied file is ignored.
: "${MGHDA_DATA_ROOT:=/path/to/private/MGHDA-data}"
: "${MEDGEMMA_MODEL_PATH:=/path/to/models/google/medgemma-4b-it}"

: "${RUN_NAME:=medgemma_study2}"
: "${MISSING_FINDING_SAMPLE_SIZE:=2}"
: "${MISSING_FINDING_SEED:=42}"
: "${SEED:=42}"
: "${BATCH_SIZE:=1}"
: "${MAX_NEW_TOKENS:=16}"
: "${TEMPERATURE:=0.0}"
: "${DTYPE:=bfloat16}"
: "${DEVICE:=cuda}"
