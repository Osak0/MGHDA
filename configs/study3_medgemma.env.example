# Copy to configs/study3_medgemma.env and edit locally. The copied file is ignored.
# MGHDA_DATA_ROOT directly contains interim/, processed/, files/, outputs/, and raw/.
: "${MGHDA_DATA_ROOT:=/path/to/data}"
: "${MODEL_PATH:=/path/to/models/google/medgemma-4b-it}"
: "${MODEL_NAME:=google/medgemma-4b-it}"

: "${STUDY3_EXPERIMENT_ID:=study3_multiselect_v2}"
: "${STUDY3_NATURAL_ANCHORS_PER_GRANULARITY:=250}"
: "${STUDY3_CONTROLLED_ANCHORS_PER_GRANULARITY:=50}"
: "${STUDY3_CONTROLLED_K:=2,3,4,5}"
: "${STUDY3_SAMPLE_SEED:=42}"
: "${RUN_NAME:=medgemma_study3_multiselect_v2}"
: "${SEED:=42}"
: "${BATCH_SIZE:=1}"
: "${MAX_NEW_TOKENS:=32}"
: "${TEMPERATURE:=0.0}"
: "${DTYPE:=bfloat16}"
: "${DEVICE:=cuda}"
: "${BOOTSTRAP_SAMPLES:=10000}"
